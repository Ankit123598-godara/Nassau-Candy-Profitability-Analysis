    "def cost_risk_category(row):\n",
    "    high_cost=row['Cost_to_Sales_%']>median_cost_ratio\n",
    "    low_margin=row['Gross_Margin_%']<median_margin\n",
    "    if high_cost and low_margin:\n",
    "        return 'High Cost and Low Margin'\n",
    "    elif high_cost and not low_margin:\n",
    "        return 'High Cost and Healthy Margin'\n",
    "    elif not high_cost and low_margin:\n",
    "        return 'Lower Cost and Low Margin'\n",
    "    else:\n",
    "        return 'Lower Cost and Healthy Margin'\n",
    "\n",
    "cost_analysis['Cost_Risk_Category']=(\n",
    "    cost_analysis.apply(cost_risk_category,axis=1))"
   ]
  },
