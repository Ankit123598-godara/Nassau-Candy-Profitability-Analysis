    "def classify_product(row):\n",
    "    high_sales=row['Sales']>=sales_median\n",
    "    high_margin=row['Gross_Margin_%']>=margin_median\n",
    "    if high_sales and high_margin:\n",
    "        return 'Star:High sales and high Margin'\n",
    "    elif high_sales and not high_margin:\n",
    "        return 'High sales and low margin'\n",
    "    elif not high_sales and high_margin:\n",
    "        return 'High margin and low sales'\n",
    "    else:\n",
    "        return 'Low sales and low margin'\n",
    "\n",
    "product_analysis['Performance_Category']=(\n",
    "    product_analysis.apply(classify_product,axis=1))"
   ]
