    "        return 'High Sales - Low Margin'\n",
    "    elif not sales_high and margin_high:\n",
    "        return 'High Margin- Low Sales'\n",
    "    else:\n",
    "        return 'Low Sales - Low Margin'\n",
    "\n",
    "master_product['Business_Category']=(\n",
    "    master_product.apply(business_category,axis=1))"
   ]
