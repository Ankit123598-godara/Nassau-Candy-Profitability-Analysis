    "def business_category(row):\n",
    "    sales_high=row['Sales']>=master_product['Sales'].median()\n",
    "    margin_high=row['Gross_Margin_%']>=master_product['Gross_Margin_%'].median()\n",
    "    if sales_high and margin_high:\n",
    "        return 'High Sales - High Margin'\n",
